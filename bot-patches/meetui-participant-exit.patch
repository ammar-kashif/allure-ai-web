+      // already flushed to disk by this point, so swallow the error and let
+      // finalizeAudioRecording run on the .tmp.webm we already have.
       if (audioCapture) {
-        await audioCapture.stop();
+        try {
+          await audioCapture.stop();
+        } catch (stopErr) {
+          this.logger.warn(
+            'audioCapture.stop() failed (likely detached frame) — continuing to finalize from .tmp.webm',
+            { stopErr: (stopErr as Error)?.message }
+          );
+        }
         audioCapture = null;
       }
       if (screenRecorder) {
-        await screenRecorder.stop();
+        try {
+          await screenRecorder.stop();
+        } catch (stopErr) {
+          this.logger.warn(
+            'screenRecorder.stop() failed (likely detached frame) — continuing',
+            { stopErr: (stopErr as Error)?.message }
+          );
+        }
         screenRecorder = null;
       }
 
